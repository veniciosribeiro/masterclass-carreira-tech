{
  "name": "techcareer-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w @techcareer/frontend",
    "dev:backend": "npm run dev -w @techcareer/backend",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "prepare": "husky",
    "e2e": "npm run build -w @techcareer/backend && VITE_API_URL=http://127.0.0.1:4100/api npm run build -w @techcareer/frontend && playwright test",
    "e2e:rapido": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "3.8.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.6"
  }
}
